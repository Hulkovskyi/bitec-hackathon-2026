{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "VITE_HOSTED_DEMO=true npm run build",
  "outputDirectory": "apps/web/dist",
  "regions": [
    "dub1"
  ],
  "functions": {
    "api/*.mjs": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api(?:/.*)?",
      "dest": "/api/index"
    },
    {
      "handle": "filesystem"
    }
  ]
}
